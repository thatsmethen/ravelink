; Independently authored RaveLink virtual audio package. See PROVENANCE.md.
[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/23/2026,0.1.0.0
CatalogFile=RaveLink.cat
PnpLockdown=1

[Manufacturer]
%Provider%=RaveLink,NTamd64.10.0...19041

[RaveLink.NTamd64.10.0...19041]
%DeviceName%=RaveLink.Device,Root\RaveLinkAudio

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%MediaName%

[SourceDisksFiles]
RaveLink.sys=1

[RaveLink.Device.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=RaveLink.Copy

[RaveLink.Copy]
RaveLink.sys

[RaveLink.Device.NT.Services]
AddService=RaveLinkAudio,0x00000002,RaveLink.Service

[RaveLink.Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\RaveLink.sys

[RaveLink.Device.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,Wave,RaveLink.Wave
AddInterface=%KSCATEGORY_RENDER%,Wave,RaveLink.Wave
AddInterface=%KSCATEGORY_CAPTURE%,Wave,RaveLink.Wave
AddInterface=%KSCATEGORY_REALTIME%,Wave,RaveLink.Wave
AddInterface=%KSCATEGORY_AUDIO%,Topology,RaveLink.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%,Topology,RaveLink.Topology

[RaveLink.Wave]
AddReg=RaveLink.Wave.Registry

[RaveLink.Topology]
AddReg=RaveLink.Topology.Registry

[RaveLink.Wave.Registry]
HKR,,CLSID,,%KSProxy%
HKR,,FriendlyName,,%CableName%

[RaveLink.Topology.Registry]
HKR,,CLSID,,%KSProxy%
HKR,,FriendlyName,,%CableName%

[Strings]
Provider="Textual"
DeviceName="RaveLink Virtual Audio"
CableName="RaveLink Cable 1"
MediaName="RaveLink driver package"
KSProxy="{17cca71b-ecd7-11d0-b908-00a0c9223196}"
KSCATEGORY_AUDIO="{6994ad04-93ef-11d0-a3cc-00a0c9223196}"
KSCATEGORY_RENDER="{65e8773e-8f56-11d0-a3b9-00a0c9223196}"
KSCATEGORY_CAPTURE="{65e8773d-8f56-11d0-a3b9-00a0c9223196}"
KSCATEGORY_REALTIME="{eb115ffc-10c8-4964-831d-6dcb02e6f23f}"
KSCATEGORY_TOPOLOGY="{dda54a40-1e4c-11d1-a050-405705c10000}"
