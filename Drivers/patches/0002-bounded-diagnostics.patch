+#if RAVELINK_FRAME_DIAGNOSTICS
+// Diagnostic-only, bounded publication. Each first-event slot has one owner and
+// is immutable after release publication. There is no callback logging, heap
+// allocation, lock, retry or reset. Reason counters intentionally overlap.
+typedef struct {
+    RLDriverDiagnosticEvent event;
+    _Atomic(UInt32) ready;
+} RaveLinkDiagnosticSlot;
+static _Atomic(UInt64) gDiagnosticReadCalls, gDiagnosticWriteCalls;
+static _Atomic(UInt64) gDiagnosticReadFrames, gDiagnosticWriteFrames, gDiagnosticStarts;
+static _Atomic(UInt64) gDiagnosticFrames[RLDiagReasonCount];
+static _Atomic(UInt64) gDiagnosticBlocks[RLDiagReasonCount];
+static RaveLinkDiagnosticSlot gDiagnosticEvents[RLDiagReasonCount][RL_DRIVER_DIAGNOSTIC_SNAPSHOTS];
+
+static Boolean RaveLinkDiagnosticProperty(AudioObjectID object, const AudioObjectPropertyAddress* address)
+{
+    return object == kObjectID_Device && address->mSelector == RL_DRIVER_DIAGNOSTIC_SELECTOR &&
+        address->mScope == kAudioObjectPropertyScopeGlobal && address->mElement == kAudioObjectPropertyElementMain;
+}
+static Boolean RaveLinkDiagnosticListProperty(AudioObjectID object, const AudioObjectPropertyAddress* address)
+{
+    return object == kObjectID_Device && address->mSelector == kAudioObjectPropertyCustomPropertyInfoList &&
+        address->mScope == kAudioObjectPropertyScopeGlobal && address->mElement == kAudioObjectPropertyElementMain;
+}
+static void RaveLinkRecordDiagnostic(UInt32 reason, UInt64 frames, RLDriverDiagnosticEvent event)
+{
+    atomic_fetch_add_explicit(&gDiagnosticFrames[reason], frames, memory_order_relaxed);
+    UInt64 ordinal = atomic_fetch_add_explicit(&gDiagnosticBlocks[reason], 1, memory_order_relaxed);
+    if (ordinal < RL_DRIVER_DIAGNOSTIC_SNAPSHOTS)
+    {
+        event.present = 1; event.reason = reason;
+        gDiagnosticEvents[reason][ordinal].event = event;
+        atomic_store_explicit(&gDiagnosticEvents[reason][ordinal].ready, 1, memory_order_release);
+    }
+}
+static void RaveLinkCopyDiagnostics(RLDriverDiagnostics* result)
+{
+    memset(result, 0, sizeof(*result));
+    result->version = RL_DRIVER_DIAGNOSTIC_VERSION;
+    result->bytes = sizeof(*result);
+    result->channels = kNumber_Of_Channels;
+    result->snapshotsPerReason = RL_DRIVER_DIAGNOSTIC_SNAPSHOTS;
+    result->readCalls = atomic_load_explicit(&gDiagnosticReadCalls, memory_order_relaxed);
+    result->writeCalls = atomic_load_explicit(&gDiagnosticWriteCalls, memory_order_relaxed);
+    result->readFrames = atomic_load_explicit(&gDiagnosticReadFrames, memory_order_relaxed);
+    result->writeFrames = atomic_load_explicit(&gDiagnosticWriteFrames, memory_order_relaxed);
+    result->startAllocations = atomic_load_explicit(&gDiagnosticStarts, memory_order_relaxed);
+    for (UInt32 reason = 0; reason < RLDiagReasonCount; ++reason)
+    {
+        result->frameCounts[reason] = atomic_load_explicit(&gDiagnosticFrames[reason], memory_order_relaxed);
+        result->blockCounts[reason] = atomic_load_explicit(&gDiagnosticBlocks[reason], memory_order_relaxed);
+        for (UInt32 index = 0; index < RL_DRIVER_DIAGNOSTIC_SNAPSHOTS; ++index)
+            if (atomic_load_explicit(&gDiagnosticEvents[reason][index].ready, memory_order_acquire))
+                result->events[reason][index] = gDiagnosticEvents[reason][index].event;
+    }
+}
+#endif
+
 
 
